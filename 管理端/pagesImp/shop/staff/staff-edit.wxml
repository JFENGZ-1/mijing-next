                <view class="modal-content data-v-74af7f6f">
                    <block wx:if="{{existPlan&&!isDepart}}">
                        <view class="data-v-74af7f6f" style="width:100%;padding-bottom:8rpx;">该员工正在任职团课或私教，删除后会致使其任课的数据无法统计且无法找回，建议改为离职状态！</view>
                        <view class="content data-v-74af7f6f">
                            <u-checkbox-group bind:__l="__l" class="data-v-74af7f6f" vueId="{{'326b3e80-13'+','+'326b3e80-12'}}" vueSlots="{{['default']}}">
                                <u-checkbox bind:__l="__l" bind:input="__e" class="data-v-74af7f6f" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '$0','checked','$event',[] ],['modal'] ] ] ] ]}}" labelSize="28rpx" shape="circle" value="{{modal.checked}}" vueId="{{'326b3e80-14'+','+'326b3e80-13'}}" vueSlots="{{['default']}}">我已阅读上面信息，仍要删除</u-checkbox>
                            </u-checkbox-group>
                        </view>
                    </block>{{''+modal.modalText+''}}</view>
                <view class="del-btn data-v-74af7f6f">
                    <button bindtap="__e" class="modal-cal-btn data-v-74af7f6f" data-event-opts="{{[ [ 'tap',[ [ 'cancelbtn',['$event'] ] ] ] ]}}" plain="true">取消</button>
                    <button bindtap="__e" class="{{['modal-btn','data-v-74af7f6f',existPlan&&!modal.checked?'grey':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'confirmbtn',['$event'] ] ] ] ]}}" plain="true">确定</button>
                </view>
            </view>
        </u-modal>
        <view class="data-v-74af7f6f">
            <permission-popup bind:__l="__l" bind:savePermissionList="__e" class="data-v-74af7f6f vue-ref" data-event-opts="{{[ [ '^savePermissionList',[ ['savePermissionList'] ] ] ]}}" data-ref="child" vueId="326b3e80-15"></permission-popup>
            <identity-popup bind:__l="__l" bind:saveIdentityList="__e" class="data-v-74af7f6f vue-ref" data-event-opts="{{[ [ '^saveIdentityList',[ ['saveIdentityList'] ] ] ]}}" data-ref="identitychild" vueId="326b3e80-16"></identity-popup>
        </view>
        <confirm-modal bind:__l="__l" class="data-v-74af7f6f vue-ref" customBtn="{{true}}" data-ref="confirmModal" title="{{confirmTitle}}" vueId="326b3e80-17" vueSlots="{{['content','btn']}}">
            <view class="data-v-74af7f6f" slot="content">
                <view class="data-v-74af7f6f">转让后您将失去<text class="data-v-74af7f6f" style="color:#DC3C5C;">本系统权属人身份及店长权限</text>，并成为本店普通员工</view>
                <view class="data-v-74af7f6f">
                    <u-checkbox bind:__l="__l" bind:input="__e" class="data-v-74af7f6f" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '','refuseChecked','$event',[] ] ] ] ] ]}}" shape="circle" size="32" value="{{refuseChecked}}" vueId="{{'326b3e80-18'+','+'326b3e80-17'}}" vueSlots="{{['default']}}">
                        <text class="data-v-74af7f6f" style="{{'font-size:26rpx;color:#606266;line-height:39rpx;'+'font-weight:'+(refuseChecked?'500':'normal')+';'}}">我已阅读并知晓，确认转让</text>
                    </u-checkbox>
                </view>
            </view>
            <view class="btn data-v-74af7f6f" slot="btn">
                <view bindtap="__e" class="modal-cal-btn button data-v-74af7f6f" data-event-opts="{{[ [ 'tap',[ [ 'cancelbtntran',['$event'] ] ] ] ]}}">取消</view>
                <view bindtap="__e" class="{{['modal-btn','button','data-v-74af7f6f',!refuseChecked?'grey':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'refuseconfirm',['$event'] ] ] ] ]}}">确定</view>
            </view>
        </confirm-modal>
        <confirm-modal bind:__l="__l" class="data-v-74af7f6f vue-ref" customBtn="{{true}}" data-ref="confirmModalFail" title="转让失败！" vueId="326b3e80-19" vueSlots="{{['content','btn']}}">
            <view class="data-v-74af7f6f" slot="content">
                <view class="data-v-74af7f6f">{{'「'+model.staffName+'」已经注册了另外一个场馆，造成转让失败！'}}</view>
                <view class="data-v-74af7f6f">需要先注销其创建的场馆后才可转让，请联系觅境客服协助您解决</view>
            </view>
            <view class="data-v-74af7f6f" slot="btn">
                <view bindtap="__e" class="modal-btn button data-v-74af7f6f" data-event-opts="{{[ [ 'tap',[ [ 'confirmbtnFail',['$event'] ] ] ] ]}}">知道了</view>
            </view>
        </confirm-modal>
        <ff-bottom-logo bind:__l="__l" class="data-v-74af7f6f" vueId="326b3e80-20"></ff-bottom-logo>
    </view>
</view>
