        <u-modal bind:__l="__l" bind:input="__e" class="data-v-74af7f6f" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '','delShow','$event',[] ] ] ] ] ]}}" showConfirmButton="{{false}}" showTitle="{{false}}" value="{{delShow}}" vueId="326b3e80-12" vueSlots="{{['default']}}" width="{{708}}">
            <view class="modal data-v-74af7f6f">
