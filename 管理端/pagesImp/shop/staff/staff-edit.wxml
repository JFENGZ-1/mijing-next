                <button bindtap="__e" class="delete-btn data-v-74af7f6f" data-event-opts="{{[ [ 'tap',[ [ 'delmodal',['$event'] ] ] ] ]}}" plain="true" wx:if="{{!model.siteOwner&&model.staffUserid}}">删除</button>
