<view class="data-v-74af7f6f">
    <navigation background="{{background}}" bind:__l="__l" class="data-v-74af7f6f" text="{{title}}" vueId="326b3e80-1"></navigation>
    <view class="staff-edit-container data-v-74af7f6f" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'}}">
        <view class="data-v-74af7f6f" style="{{'height:100%;min-height:1230rpx;'}}">
            <view class="subsection-box data-v-74af7f6f" wx:if="{{!model.siteOwner&&model.staffUserid}}">
                <u-subsection activeColor="#ffffff" bind:__l="__l" bind:change="__e" buttonColor="{{subsectionIndex==0?'#22C788':'#DC3C5C'}}" class="data-v-74af7f6f" current="{{subsectionIndex}}" data-event-opts="{{[ [ '^change',[ ['sectionChange'] ] ] ]}}" fontSize="22" inactiveColor="#7E7E7E" list="{{subsectionList}}" vueId="326b3e80-2"></u-subsection>
            </view>
            <u-form bind:__l="__l" class="data-v-74af7f6f vue-ref" data-ref="uForm" errorType="{{['toast']}}" model="{{model}}" vueId="326b3e80-3" vueSlots="{{['default']}}">
                <view class="imghead data-v-74af7f6f">
                    <image class="img data-v-74af7f6f" src="{{imgurl}}" wx:if="{{imgurl}}"></image>
                    <image class="headimg data-v-74af7f6f" src="{{$root.m0}}" wx:else></image>
                    <view bindtap="__e" class="slot-btn data-v-74af7f6f" data-event-opts="{{[ [ 'tap',[ [ 'chooseAvatar',['$event'] ] ] ] ]}}" hoverClass="slot-btn__hover" hoverStayTime="150" slot="addBtn" style=";" wx:if="{{title!='添加员工/教练'}}">
                        <view class="imghead-text data-v-74af7f6f">
                            <image class="cameraicon data-v-74af7f6f" src="{{$root.m1}}"></image>
                            <text class="data-v-74af7f6f">修改头像</text>
                        </view>
                    </view>
                </view>
                <u-form-item bind:__l="__l" class="data-v-74af7f6f" label="姓名" labelWidth="100" prop="staffName" required="{{true}}" vueId="{{'326b3e80-4'+','+'326b3e80-3'}}" vueSlots="{{['default']}}">
                    <u-input bind:__l="__l" bind:input="__e" class="data-v-74af7f6f" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '$0','staffName','$event',[] ],['model'] ] ] ] ]}}" placeholder="请输入姓名" placeholderStyle="font-size:28rpx;color:#DADADA" type="text" value="{{model.staffName}}" vueId="{{'326b3e80-5'+','+'326b3e80-4'}}"></u-input>
                </u-form-item>
                <u-cell-item bind:__l="__l" bind:click="__e" class="uni-form-item-required data-v-74af7f6f" data-event-opts="{{[ [ '^click',[ ['e0'] ] ] ]}}" hoverClass="none" require="{{true}}" title="性别" titleStyle="{{titleStyle}}" vueId="{{'326b3e80-6'+','+'326b3e80-3'}}" vueSlots="{{['default']}}">
                    <text class="data-v-74af7f6f" hidden="{{!model.staffSexName}}">{{model.staffSexName}}</text>
                </u-cell-item>
                <u-action-sheet bind:__l="__l" bind:click="__e" bind:input="__e" class="data-v-74af7f6f" data-event-opts="{{[ [ '^click',[ ['actionSheetCallback'] ] ],[ '^input',[ [ '__set_model',[ '','show','$event',[] ] ] ] ] ]}}" list="{{list}}" tips="{{tips}}" value="{{show}}" vueId="{{'326b3e80-7'+','+'326b3e80-3'}}"></u-action-sheet>
                <u-form-item bind:__l="__l" class="data-v-74af7f6f" label="手机" labelWidth="100" prop="staffTel" required="{{true}}" vueId="{{'326b3e80-8'+','+'326b3e80-3'}}" vueSlots="{{['default']}}">
                    <u-input bind:__l="__l" bind:input="__e" class="data-v-74af7f6f" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '$0','staffTel','$event',[] ],['model'] ] ] ] ]}}" placeholder="请输入手机" placeholderStyle="font-size:28rpx;color:#DADADA" type="number" value="{{model.staffTel}}" vueId="{{'326b3e80-9'+','+'326b3e80-8'}}"></u-input>
                </u-form-item>
                <u-cell-item bind:__l="__l" bind:click="__e" class="uni-form-item-required data-v-74af7f6f" data-event-opts="{{[ [ '^click',[ ['openIdentity'] ] ] ]}}" hoverClass="none" require="{{true}}" title="身份" titleStyle="{{titleStyle}}" vueId="{{'326b3e80-10'+','+'326b3e80-3'}}" vueSlots="{{['default']}}">
                    <text class="data-v-74af7f6f" hidden="{{!model.identName}}">{{model.identName}}</text>
                </u-cell-item>
                <u-cell-item arrow="{{!(model.staffType==2||model.staffType==3)}}" bind:__l="__l" bind:click="__e" class="uni-form-item-required data-v-74af7f6f" data-event-opts="{{[ [ '^click',[ ['openPopup'] ] ] ]}}" hoverClass="none" require="{{true}}" title="权限" titleStyle="{{titleStyle}}" vueId="{{'326b3e80-11'+','+'326b3e80-3'}}" vueSlots="{{['default']}}">
