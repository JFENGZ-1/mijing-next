<view class="data-v-12443ad8">
    <navigation background="#FFFFFF" bind:__l="__l" class="data-v-12443ad8" text="收款统计" vueId="317ecc74-1"></navigation>
    <view class="main data-v-12443ad8" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'}}">
        <view class="content data-v-12443ad8">
            <view class="head data-v-12443ad8">
                <view class="data-v-12443ad8" style="height:52rpx;">
                    <hint bind:__l="__l" class="data-v-12443ad8 vue-ref" data-ref="hint" show="{{hintShow}}" updateTime="{{computeTime.computeTime}}" vueId="317ecc74-2" vueSlots="{{['confirmname']}}">
                        <view class="data-v-12443ad8" slot="confirmname">
                            <view class="data-v-12443ad8">
                                <text class="data-v-12443ad8" style="color:#181818;">新增会员：</text>新添加的会员且名下至少有一张卡</view>
                            <view class="data-v-12443ad8">
                                <text class="data-v-12443ad8" style="color:#181818;">售卡：</text>会员在线购卡张数和手动发卡张数</view>
                            <view class="data-v-12443ad8">
                                <text class="data-v-12443ad8" style="color:#181818;">收款：</text>在线购卡或手动发卡时填写的【实际收款】</view>
                        </view>
                    </hint>
                </view>
            </view>
            <view class="data-v-12443ad8" wx:for="{{list}}" wx:key="index">
                <view class="summarize data-v-12443ad8">
                    <view class="item_time data-v-12443ad8">
                        <view class="item_title data-v-12443ad8">
                            <view class="title_color data-v-12443ad8"></view>
                            <view class="title_text data-v-12443ad8" wx:if="{{item.isNowYear}}">今年</view>
                            <view class="title_text data-v-12443ad8" wx:else>{{item.year+'年'}}</view>
                        </view>
                    </view>
                    <view class="data-v-12443ad8">
                        <view class="top_data data-v-12443ad8">
                            <view class="more-data data-v-12443ad8">
                                <view class="item data-v-12443ad8">
                                    <view class="info data-v-12443ad8">
                                        <view class="data-v-12443ad8">新增会员</view>
                                        <view class="info-foot data-v-12443ad8">
                                            <text class="info_num data-v-12443ad8">{{item.totalUsercount==undefined?'--':item.totalUsercount}}</text>
                                            <text class="info_name data-v-12443ad8">名</text>
                                        </view>
                                    </view>
                                </view>
                                <u-line bind:__l="__l" class="data-v-12443ad8" color="#DADADA" direction="col" length="58rpx" vueId="{{'317ecc74-3-'+index}}"></u-line>
                                <view class="item data-v-12443ad8">
                                    <view class="info data-v-12443ad8">
                                        <view class="data-v-12443ad8">售卡</view>
                                        <view class="info-foot data-v-12443ad8">
                                            <text class="info_num data-v-12443ad8">{{(item.totalCardCount==undefined?'--':item.totalCardCount)+''}}</text>
                                            <text class="info_name data-v-12443ad8">张</text>
                                        </view>
                                    </view>
                                </view>
                                <u-line bind:__l="__l" class="data-v-12443ad8" color="#DADADA" direction="col" length="58rpx" vueId="{{'317ecc74-4-'+index}}"></u-line>
                                <view class="item data-v-12443ad8">
                                    <view class="info data-v-12443ad8">
                                        <view class="data-v-12443ad8">收款</view>
                                        <view class="info-foot data-v-12443ad8">
                                            <text class="info_name data-v-12443ad8">￥</text>
                                            <text class="info_num data-v-12443ad8">{{item.totalCash==undefined?'--':item.totalCash}}</text>
                                        </view>
                                    </view>
                                </view>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="list data-v-12443ad8">
                    <view class="item data-v-12443ad8">
                        <view class="data-v-12443ad8">
                            <view class="item_head data-v-12443ad8">
                                <view class="item_right data-v-12443ad8" style="padding-bottom:6rpx;padding-right:25rpx;">
                                    <view class="item_below data-v-12443ad8">
                                        <view class="item_left data-v-12443ad8">月份</view>
                                        <view class="item_explain explain_first data-v-12443ad8">新增会员</view>
                                        <view class="item_explain explain_center data-v-12443ad8">售卡</view>
                                        <view class="item_explain data-v-12443ad8" style="width:200rpx;">收款</view>
                                    </view>
                                </view>
                            </view>
                        </view>
                    </view>
                    <view class="item data-v-12443ad8">
                        <view bindtap="__e" class="data-v-12443ad8" data-event-opts="{{[ [ 'tap',[ [ 'headleDelete',['$0','$1'],[ [ ['list','',index],['monthList','',index1,'monthNum'] ],[ ['list','',index],['monthList','',index1,'yearNum'] ] ] ] ] ] ]}}" wx:for="{{item.monthList}}" wx:for-index="index1" wx:for-item="item1" wx:key="index1">
                            <view class="item_con data-v-12443ad8">
                                <view class="item_right data-v-12443ad8">
                                    <view class="item_below data-v-12443ad8">
                                        <view class="item_left data-v-12443ad8">{{''+item1.monthNum+'月'}}</view>
                                        <view class="item_explain explain_first num_font data-v-12443ad8">{{''+item1.newUserCount}}<text class="unit data-v-12443ad8">名</text>
                                        </view>
                                        <view class="item_explain explain_center num_font data-v-12443ad8">{{''+item1.saleCardCount}}<text class="unit data-v-12443ad8">张</text>
                                        </view>
                                        <view class="item_explain num_font data-v-12443ad8" style="text-align:end;width:200rpx;padding-right:8rpx;">
                                            <text class="unit data-v-12443ad8">￥</text>{{item1.saleCash+''}}</view>
                                        <u-icon bind:__l="__l" class="arrow-right data-v-12443ad8" color="#989898" name="arrow-right" size="15" vueId="{{'317ecc74-5-'+index+'-'+index1}}"></u-icon>
                                    </view>
                                </view>
                            </view>
                            <view class="data-v-12443ad8" style="padding-left:150rpx;padding-right:20rpx;">
                                <u-line bind:__l="__l" class="data-v-12443ad8" color="#F0F0F0" vueId="{{'317ecc74-6-'+index+'-'+index1}}"></u-line>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <view class="nodata data-v-12443ad8" wx:if="{{$root.g0}}">
            <u-divider bgColor="#f5f5f5" bind:__l="__l" borderColor="#dadada" class="data-v-12443ad8" color="#bfbfbf" halfWidth="74" vueId="317ecc74-7" vueSlots="{{['default']}}">没有更多了哦</u-divider>
        </view>
        <ff-bottom-logo bind:__l="__l" class="data-v-12443ad8" vueId="317ecc74-8"></ff-bottom-logo>
    </view>
</view>
