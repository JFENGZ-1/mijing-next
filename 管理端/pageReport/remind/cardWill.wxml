<view class="data-v-4e832224">
    <navigation background="#FFFFFF" bind:__l="__l" class="data-v-4e832224" text="{{title}}" vueId="65497358-1"></navigation>
    <view class="main data-v-4e832224" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'}}">
        <view class="content data-v-4e832224">
            <view class="head data-v-4e832224" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'+'top:'+StatusBar+CustomBar+'px'+';'}}">
                <view class="hint_wrap data-v-4e832224">
                    <hint bgcolor="#ECF8F3" bind:__l="__l" class="data-v-4e832224" color="#22C788" show="{{hintShow}}" type="2" updateTime="{{computeTime}}" vueId="65497358-2" vueSlots="{{['confirmname']}}">
                        <view class="data-v-4e832224" slot="confirmname">
                            <view class="data-v-4e832224">
                                <text class="data-v-4e832224" style="color:#181818;">统计说明：</text>
                                <text class="value data-v-4e832224">当指定了开卡日期或接近最晚开卡日期时显示</text>
                            </view>
                        </view>
                    </hint>
                </view>
                <view class="summarize data-v-4e832224">
                    <view class="top_data data-v-4e832224">
                        <view class="more-data data-v-4e832224">
                            <view class="data-v-4e832224">{{'开卡日期前 '+config.intValue+' 天提醒'}}</view>
                            <view bindtap="__e" class="data-v-4e832224" data-event-opts="{{[ [ 'tap',[ ['handleSet'] ] ] ]}}" style="display:flex;">
                                <image class="icon data-v-4e832224" src="{{$root.m0}}"></image>
                                <u-icon bind:__l="__l" class="arrow-right data-v-4e832224" color="#989898" name="arrow-right" size="16" vueId="65497358-3"></u-icon>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="item data-v-4e832224">
                    <view class="item_head data-v-4e832224">
                        <view class="item_right data-v-4e832224">{{'共有'+totalCount+'张会员卡'}}</view>
                    </view>
                </view>
            </view>
            <view class="setting_wrap data-v-4e832224">
                <view class="list data-v-4e832224">
                    <view class="item data-v-4e832224" wx:if="{{!notdata}}">
                        <view class="data-v-4e832224" style="padding-top:20rpx;" wx:for="{{$root.l0}}" wx:for-index="index1" wx:key="index1">
                            <view class="sale-item data-v-4e832224">
                                <image bindtap="__e" class="avator data-v-4e832224" data-event-opts="{{[ [ 'tap',[ [ 'memberDetails',['$0'],[ [ ['list','',index1] ] ] ] ] ] ]}}" src="{{item.$orig.userFaceurl}}"></image>
                                <view class="detail-info data-v-4e832224">
                                    <view bindtap="__e" class="detail-info-wrap data-v-4e832224" data-event-opts="{{[ [ 'tap',[ [ 'memberDetails',['$0'],[ [ ['list','',index1] ] ] ] ] ] ]}}">
                                        <view class="l-info data-v-4e832224">{{''+item.m1+''}}<view class="time-and-type data-v-4e832224">最后上课：<text class="data-v-4e832224" wx:if="{{item.$orig.lastClassDate}}">{{item.g0}}</text>
                                                <text class="data-v-4e832224" wx:else>--</text>
                                            </view>
                                        </view>
                                        <view class="r-info data-v-4e832224">
                                            <u-icon bind:__l="__l" class="arrow-right data-v-4e832224" color="#989898" name="arrow-right" size="15" vueId="{{'65497358-4-'+index1}}"></u-icon>
                                        </view>
                                    </view>
                                </view>
                            </view>
                            <view class="foot_card data-v-4e832224">
                                <member-card activeClass="medium-sized" bind:__l="__l" cardInfo="{{item.$orig}}" class="data-v-4e832224" jumpcardDetail="{{true}}" vueId="{{'65497358-5-'+index1}}"></member-card>
                                <view class="will_content data-v-4e832224">开卡日期：<text class="will_time data-v-4e832224" wx:if="{{item.$orig.willOpendate}}">{{item.g1}}</text>
                                    <text class="will_time data-v-4e832224" wx:else>--</text>
                                </view>
                            </view>
                            <u-line bind:__l="__l" class="data-v-4e832224" color="#F0F0F0" length="570rpx" margin="0rpx 0rpx 0rpx 100rpx" vueId="{{'65497358-6-'+index1}}" wx:if="{{item.g2-1!=index1}}"></u-line>
                        </view>
                    </view>
                    <view class="data-v-4e832224" wx:else>
                        <view class="noCourseData data-v-4e832224">
                            <image class="icon data-v-4e832224" src="{{$root.m2}}"></image>
                            <text class="explain data-v-4e832224">~ 没有即将开卡的会员卡 ~</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <view class="nodata data-v-4e832224" wx:if="{{!notdata&&ismore}}">
            <u-divider bgColor="#f5f5f5" bind:__l="__l" borderColor="#dadada" class="data-v-4e832224" color="#bfbfbf" halfWidth="74" vueId="65497358-7" vueSlots="{{['default']}}">没有更多了哦</u-divider>
        </view>
        <ff-bottom-logo bind:__l="__l" class="data-v-4e832224" vueId="65497358-8"></ff-bottom-logo>
    </view>
</view>
