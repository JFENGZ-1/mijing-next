<view class="data-v-1d2768b4">
    <navigation background="#FFFFFF" bind:__l="__l" class="data-v-1d2768b4" text="{{title}}" vueId="0f132efc-1"></navigation>
    <view class="main data-v-1d2768b4" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'}}">
        <view class="content data-v-1d2768b4">
            <view class="head data-v-1d2768b4" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'+'top:'+StatusBar+CustomBar+'px'+';'}}">
                <view class="hint_wrap data-v-1d2768b4">
                    <hint bgcolor="#ECF8F3" bind:__l="__l" class="data-v-1d2768b4" color="#22C788" show="{{hintShow}}" type="2" updateTime="{{computeTime}}" vueId="0f132efc-2" vueSlots="{{['confirmname']}}">
                        <view class="data-v-1d2768b4" slot="confirmname">
                            <view class="data-v-1d2768b4">
                                <text class="data-v-1d2768b4" style="color:#181818;">有效会员：</text>
                                <text class="value data-v-1d2768b4">名下会员卡至少一张有余额且未过期的会员 </text>
                            </view>
                            <view class="data-v-1d2768b4">
                                <text class="data-v-1d2768b4" style="color:#181818;">无效会员：</text>
                                <text class="value data-v-1d2768b4">名下会员卡均已无余额或已过期的会员</text>
                            </view>
                        </view>
                    </hint>
                </view>
                <view class="summarize data-v-1d2768b4">
                    <view class="top_data data-v-1d2768b4">
                        <view class="more-data data-v-1d2768b4">
                            <view class="data-v-1d2768b4">{{'会员入会纪念日前 '+config.intValue+' 天时提醒'}}</view>
                            <view bindtap="__e" class="data-v-1d2768b4" data-event-opts="{{[ [ 'tap',[ ['handleSet'] ] ] ]}}" style="display:flex;">
                                <image class="icon data-v-1d2768b4" src="{{$root.m0}}"></image>
                                <u-icon bind:__l="__l" class="arrow-right data-v-1d2768b4" color="#989898" name="arrow-right" size="16" vueId="0f132efc-3"></u-icon>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="item data-v-1d2768b4">
                    <view class="item_head data-v-1d2768b4">
                        <view class="item_right data-v-1d2768b4">{{'共有'+totalCount+'名会员'}}</view>
                        <view class="filter data-v-1d2768b4">
                            <view bindtap="__e" class="{{['data-v-1d2768b4',userStatus==item.$orig.id?'active':'filter-item']}}" data-event-opts="{{[ [ 'tap',[ [ 'headlememberStatus',['$0'],[ [ ['memberStatus','',index] ] ] ] ] ] ]}}" wx:for="{{$root.l0}}" wx:key="index">
                                <view class="tag data-v-1d2768b4">{{item.$orig.name+''}}<view class="triangle data-v-1d2768b4">
                                        <image class="icon data-v-1d2768b4" mode="widthFix" src="{{item.m1}}" wx:if="{{userStatus==item.$orig.id}}"></image>
                                    </view>
                                </view>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
            <view class="setting_wrap data-v-1d2768b4">
                <view class="list data-v-1d2768b4">
                    <view class="item data-v-1d2768b4" wx:if="{{!notdata}}">
                        <view class="data-v-1d2768b4" style="padding-top:28rpx;" wx:for="{{$root.l1}}" wx:for-index="index1" wx:key="index1">
                            <view class="sale-item data-v-1d2768b4">
                                <image bindtap="__e" class="avator data-v-1d2768b4" data-event-opts="{{[ [ 'tap',[ [ 'memberDetails',['$0'],[ [ ['list','',index1] ] ] ] ] ] ]}}" src="{{item.$orig.userFaceurl}}"></image>
                                <view class="detail-info data-v-1d2768b4">
                                    <view bindtap="__e" class="detail-info-wrap data-v-1d2768b4" data-event-opts="{{[ [ 'tap',[ [ 'memberDetails',['$0'],[ [ ['list','',index1] ] ] ] ] ] ]}}">
                                        <view class="l-info data-v-1d2768b4">{{''+item.m2+''}}<view class="time-and-type data-v-1d2768b4">最后上课：<text class="data-v-1d2768b4" wx:if="{{item.$orig.lastClassDate}}">{{item.g0}}</text>
                                                <text class="data-v-1d2768b4" wx:else>--</text>
                                            </view>
                                        </view>
                                        <view class="r-info data-v-1d2768b4">
                                            <view class="data-v-1d2768b4" style="text-align:end;">
                                                <text class="day-num data-v-1d2768b4">{{item.$orig.isdefault+'周年'}}</text>
                                                <view class="day-tex data-v-1d2768b4">入会<text class="daytime data-v-1d2768b4" wx:if="{{item.$orig.createTime}}">{{item.g1}}</text>
                                                    <text class="daytime data-v-1d2768b4" wx:else>--</text>
                                                </view>
                                            </view>
                                            <u-icon bind:__l="__l" class="arrow-right data-v-1d2768b4" color="#989898" name="arrow-right" size="15" vueId="{{'0f132efc-4-'+index1}}"></u-icon>
                                        </view>
                                    </view>
                                </view>
                            </view>
                            <u-line bind:__l="__l" class="data-v-1d2768b4" color="#F0F0F0" length="576rpx" margin="0rpx 0rpx 0rpx 98rpx" vueId="{{'0f132efc-5-'+index1}}" wx:if="{{item.g2-1!=index1}}"></u-line>
                        </view>
                    </view>
                    <view class="data-v-1d2768b4" wx:else>
                        <view class="noCourseData data-v-1d2768b4">
                            <image class="icon data-v-1d2768b4" src="{{$root.m3}}"></image>
                            <text class="explain data-v-1d2768b4">~ 没有入会纪念日到的会员~</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <view class="nodata data-v-1d2768b4" wx:if="{{!notdata&&ismore}}">
            <u-divider bgColor="#f5f5f5" bind:__l="__l" borderColor="#dadada" class="data-v-1d2768b4" color="#bfbfbf" halfWidth="74" vueId="0f132efc-6" vueSlots="{{['default']}}">没有更多了哦</u-divider>
        </view>
        <ff-bottom-logo bind:__l="__l" class="data-v-1d2768b4" vueId="0f132efc-7"></ff-bottom-logo>
    </view>
</view>
