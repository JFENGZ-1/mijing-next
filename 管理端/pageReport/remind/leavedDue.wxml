<view class="data-v-01d25dbb">
    <navigation background="#FFFFFF" bind:__l="__l" class="data-v-01d25dbb" text="{{title}}" vueId="5572617b-1"></navigation>
    <view class="main data-v-01d25dbb" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'}}">
        <view class="content data-v-01d25dbb">
            <view class="head data-v-01d25dbb" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'+'top:'+StatusBar+CustomBar+'px'+';'}}">
                <view class="hint_wrap data-v-01d25dbb">
                    <hint bgcolor="#ECF8F3" bind:__l="__l" class="data-v-01d25dbb" color="#22C788" show="{{hintShow}}" type="2" updateTime="{{computeTime}}" vueId="5572617b-2" vueSlots="{{['confirmname']}}">
                        <view class="data-v-01d25dbb" slot="confirmname">
                            <view class="data-v-01d25dbb">
                                <text class="data-v-01d25dbb" style="color:#181818;">统计说明：</text>
                                <text class="value data-v-01d25dbb">系统将自动结束请假到期的卡，不需要手动结束（结束请假前剩余多少天，结束后仍然剩余多少天）</text>
                            </view>
                        </view>
                    </hint>
                </view>
                <view class="summarize data-v-01d25dbb">
                    <view class="top_data data-v-01d25dbb">
                        <view class="more-data data-v-01d25dbb">
                            <view class="data-v-01d25dbb">{{'有效期剩余 '+config.intValue+' 天时提醒'}}</view>
                            <view bindtap="__e" class="data-v-01d25dbb" data-event-opts="{{[ [ 'tap',[ ['handleSet'] ] ] ]}}" style="display:flex;">
                                <image class="icon data-v-01d25dbb" src="{{$root.m0}}"></image>
                                <u-icon bind:__l="__l" class="arrow-right data-v-01d25dbb" color="#989898" name="arrow-right" size="16" vueId="5572617b-3"></u-icon>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="item data-v-01d25dbb">
                    <view class="item_head data-v-01d25dbb">
                        <view class="item_right data-v-01d25dbb">{{'共有'+totalCount+'张会员卡'}}</view>
                    </view>
                </view>
            </view>
            <view class="setting_wrap data-v-01d25dbb">
                <view class="list data-v-01d25dbb">
                    <view class="item data-v-01d25dbb" wx:if="{{!notdata}}">
                        <view class="data-v-01d25dbb" style="padding-top:20rpx;" wx:for="{{$root.l0}}" wx:for-index="index1" wx:key="index1">
                            <view class="sale-item data-v-01d25dbb">
                                <image bindtap="__e" class="avator data-v-01d25dbb" data-event-opts="{{[ [ 'tap',[ [ 'memberDetails',['$0'],[ [ ['list','',index1] ] ] ] ] ] ]}}" src="{{item.$orig.userFaceurl}}"></image>
                                <view class="detail-info data-v-01d25dbb">
                                    <view bindtap="__e" class="detail-info-wrap data-v-01d25dbb" data-event-opts="{{[ [ 'tap',[ [ 'memberDetails',['$0'],[ [ ['list','',index1] ] ] ] ] ] ]}}">
                                        <view class="l-info data-v-01d25dbb">{{''+item.m1+''}}<view class="time-and-type data-v-01d25dbb">最后上课：<text class="data-v-01d25dbb" wx:if="{{item.$orig.lastClassDate}}">{{item.g0}}</text>
                                                <text class="data-v-01d25dbb" wx:else>--</text>
                                            </view>
                                        </view>
                                        <view class="r-info data-v-01d25dbb">
                                            <u-icon bind:__l="__l" class="arrow-right data-v-01d25dbb" color="#989898" name="arrow-right" size="15" vueId="{{'5572617b-4-'+index1}}"></u-icon>
                                        </view>
                                    </view>
                                </view>
                            </view>
                            <view class="foot_card data-v-01d25dbb">
                                <member-card activeClass="medium-sized" bind:__l="__l" cardInfo="{{item.$orig}}" class="data-v-01d25dbb" jumpcardDetail="{{true}}" vueId="{{'5572617b-5-'+index1}}"></member-card>
                                <view class="foot-text data-v-01d25dbb">
                                    <text class="data-v-01d25dbb">请假:</text>
                                    <text class="rq data-v-01d25dbb">{{item.g1}}</text>至<text class="rq data-v-01d25dbb">{{item.g2}}</text>
                                </view>
                            </view>
                            <u-line bind:__l="__l" class="data-v-01d25dbb" color="#F0F0F0" length="570rpx" margin="0rpx 0rpx 0rpx 100rpx" vueId="{{'5572617b-6-'+index1}}" wx:if="{{item.g3-1!=index1}}"></u-line>
                        </view>
                    </view>
                    <view class="data-v-01d25dbb" wx:else>
                        <view class="noCourseData data-v-01d25dbb">
                            <image class="icon data-v-01d25dbb" src="{{$root.m2}}"></image>
                            <text class="explain data-v-01d25dbb">~ 没有请假到期的会员 ~</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <view class="nodata data-v-01d25dbb" wx:if="{{!notdata&&ismore}}">
            <u-divider bgColor="#f5f5f5" bind:__l="__l" borderColor="#dadada" class="data-v-01d25dbb" color="#bfbfbf" halfWidth="74" vueId="5572617b-7" vueSlots="{{['default']}}">没有更多了哦</u-divider>
        </view>
        <ff-bottom-logo bind:__l="__l" class="data-v-01d25dbb" vueId="5572617b-8"></ff-bottom-logo>
    </view>
</view>
