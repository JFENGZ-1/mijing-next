<view class="data-v-47319aec">
    <navigation background="#FFFFFF" bind:__l="__l" class="data-v-47319aec" text="{{title}}" vueId="1524ea84-1"></navigation>
    <view class="main data-v-47319aec" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'}}">
        <view class="content data-v-47319aec">
            <view class="head data-v-47319aec" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'+'top:'+StatusBar+CustomBar+'px'+';'}}">
                <view class="hint_wrap data-v-47319aec">
                    <hint bgcolor="#ECF8F3" bind:__l="__l" class="data-v-47319aec" color="#22C788" show="{{hintShow}}" type="2" updateTime="{{computeTime}}" vueId="1524ea84-2" vueSlots="{{['confirmname']}}">
                        <view class="data-v-47319aec" slot="confirmname">
                            <view class="data-v-47319aec">
                                <text class="data-v-47319aec" style="color:#181818;">统计说明：</text>
                                <text class="value data-v-47319aec">该数据每日统计一次</text>
                            </view>
                        </view>
                    </hint>
                </view>
                <view class="summarize data-v-47319aec">
                    <view class="top_data data-v-47319aec">
                        <view class="more-data data-v-47319aec">
                            <view class="data-v-47319aec">{{'有效期剩余 '+config.intValue+' 天时提醒'}}</view>
                            <view bindtap="__e" class="data-v-47319aec" data-event-opts="{{[ [ 'tap',[ ['handleSet'] ] ] ]}}" style="display:flex;">
                                <image class="icon data-v-47319aec" src="{{$root.m0}}"></image>
                                <u-icon bind:__l="__l" class="arrow-right data-v-47319aec" color="#989898" name="arrow-right" size="16" vueId="1524ea84-3"></u-icon>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="item data-v-47319aec">
                    <view class="item_head data-v-47319aec">
                        <view class="item_right data-v-47319aec">{{'共有'+totalCount+'张会员卡'}}</view>
                    </view>
                </view>
            </view>
            <view class="setting_wrap data-v-47319aec">
                <view class="list data-v-47319aec">
                    <view class="item data-v-47319aec" wx:if="{{!notdata}}">
                        <view class="data-v-47319aec" style="padding-top:20rpx;" wx:for="{{$root.l0}}" wx:for-index="index1" wx:key="index1">
                            <view class="sale-item data-v-47319aec">
                                <image bindtap="__e" class="avator data-v-47319aec" data-event-opts="{{[ [ 'tap',[ [ 'memberDetails',['$0'],[ [ ['list','',index1] ] ] ] ] ] ]}}" src="{{item.$orig.userFaceurl}}"></image>
                                <view class="detail-info data-v-47319aec">
                                    <view bindtap="__e" class="detail-info-wrap data-v-47319aec" data-event-opts="{{[ [ 'tap',[ [ 'memberDetails',['$0'],[ [ ['list','',index1] ] ] ] ] ] ]}}">
                                        <view class="l-info data-v-47319aec">{{''+item.m1+''}}<view class="time-and-type data-v-47319aec">最后上课：<text class="data-v-47319aec" wx:if="{{item.$orig.lastClassDate}}">{{item.g0}}</text>
                                                <text class="data-v-47319aec" wx:else>--</text>
                                            </view>
                                        </view>
                                        <view class="r-info data-v-47319aec">
                                            <u-icon bind:__l="__l" class="arrow-right data-v-47319aec" color="#989898" name="arrow-right" size="15" vueId="{{'1524ea84-4-'+index1}}"></u-icon>
                                        </view>
                                    </view>
                                </view>
                            </view>
                            <view class="foot_card data-v-47319aec">
                                <member-card activeClass="medium-sized" bind:__l="__l" cardInfo="{{item.$orig}}" class="data-v-47319aec" jumpcardDetail="{{true}}" vueId="{{'1524ea84-5-'+index1}}"></member-card>
                            </view>
                            <u-line bind:__l="__l" class="data-v-47319aec" color="#F0F0F0" length="570rpx" margin="0rpx 0rpx 0rpx 100rpx" vueId="{{'1524ea84-6-'+index1}}" wx:if="{{item.g1-1!=index1}}"></u-line>
                        </view>
                    </view>
                    <view class="data-v-47319aec" wx:else>
                        <view class="noCourseData data-v-47319aec">
                            <image class="icon data-v-47319aec" src="{{$root.m2}}"></image>
                            <text class="explain data-v-47319aec">~ 没有会员卡即将到期 ~</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <view class="nodata data-v-47319aec" wx:if="{{!notdata&&ismore}}">
            <u-divider bgColor="#f5f5f5" bind:__l="__l" borderColor="#dadada" class="data-v-47319aec" color="#bfbfbf" halfWidth="74" vueId="1524ea84-7" vueSlots="{{['default']}}">没有更多了哦</u-divider>
        </view>
        <ff-bottom-logo bind:__l="__l" class="data-v-47319aec" vueId="1524ea84-8"></ff-bottom-logo>
    </view>
</view>
