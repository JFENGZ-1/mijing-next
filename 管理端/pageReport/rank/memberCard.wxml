<view class="data-v-dd7cd12e">
    <navigation background="#FFFFFF" bind:__l="__l" class="data-v-dd7cd12e" text="{{title}}" vueId="5fb2c237-1"></navigation>
    <view class="main data-v-dd7cd12e" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'}}">
        <view class="content data-v-dd7cd12e">
            <view class="head data-v-dd7cd12e" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'+'top:'+StatusBar+CustomBar+'px'+';'}}">
                <view class="item data-v-dd7cd12e">
                    <view class="item_head data-v-dd7cd12e">
                        <view class="item_right data-v-dd7cd12e" wx:if="{{cardId==0}}">{{'共有'+totalCount+'名会员'}}</view>
                        <view class="item_right data-v-dd7cd12e" wx:else>{{'共有'+totalCount+'张会员卡'}}</view>
                    </view>
                </view>
            </view>
            <view class="setting_wrap data-v-dd7cd12e">
                <view class="list data-v-dd7cd12e">
                    <view class="item data-v-dd7cd12e" wx:if="{{!notdata}}">
                        <view class="data-v-dd7cd12e" style="padding-top:20rpx;" wx:for="{{$root.l0}}" wx:for-index="index1" wx:key="index1">
                            <view class="sale-item data-v-dd7cd12e">
                                <image bindtap="__e" class="avator data-v-dd7cd12e" data-event-opts="{{[ [ 'tap',[ [ 'memberDetails',['$0'],[ [ ['list','',index1] ] ] ] ] ] ]}}" src="{{item.$orig.userFaceurl}}"></image>
                                <view class="detail-info data-v-dd7cd12e">
                                    <view bindtap="__e" class="detail-info-wrap data-v-dd7cd12e" data-event-opts="{{[ [ 'tap',[ [ 'memberDetails',['$0'],[ [ ['list','',index1] ] ] ] ] ] ]}}">
                                        <view class="l-info data-v-dd7cd12e">{{''+item.m0+''}}<view class="time-and-type data-v-dd7cd12e">最后上课:<text class="data-v-dd7cd12e" wx:if="{{item.$orig.lastClassDate}}">{{item.g0}}</text>
                                                <text class="data-v-dd7cd12e" wx:else>--</text>
                                            </view>
                                        </view>
                                        <view class="r-info data-v-dd7cd12e">
                                            <u-icon bind:__l="__l" class="arrow-right data-v-dd7cd12e" color="#989898" name="arrow-right" size="15" vueId="{{'5fb2c237-2-'+index1}}"></u-icon>
                                        </view>
                                    </view>
                                </view>
                            </view>
                            <view class="foot_card data-v-dd7cd12e">
                                <view class="on-card data-v-dd7cd12e" wx:if="{{cardId==0}}">
                                    <image class="img data-v-dd7cd12e" mode="widthFix" src="{{item.m1}}"></image>
                                </view>
                                <member-card activeClass="medium-sized" bind:__l="__l" cardInfo="{{item.$orig}}" class="data-v-dd7cd12e" jumpcardDetail="{{true}}" vueId="{{'5fb2c237-3-'+index1}}" wx:else></member-card>
                                <view class="data-v-dd7cd12e" wx:if="{{mode==9}}">
                                    <view class="will_content data-v-dd7cd12e">停卡日期:<text class="will_time data-v-dd7cd12e" wx:if="{{item.$orig.stopcardHappenDate}}">{{item.g1}}</text>
                                        <text class="will_time data-v-dd7cd12e" wx:else>--</text>
                                    </view>
                                </view>
                                <view class="data-v-dd7cd12e" wx:if="{{mode==8}}">
                                    <view class="will_content data-v-dd7cd12e">请假：<text class="will_time data-v-dd7cd12e" wx:if="{{item.$orig.holidayBtime}}">{{item.g2}}</text>至<text class="will_time data-v-dd7cd12e" wx:if="{{item.$orig.holidayEtime}}">{{item.g3}}</text>
                                    </view>
                                </view>
                            </view>
                            <u-line bind:__l="__l" class="data-v-dd7cd12e" color="#F0F0F0" length="570rpx" margin="0rpx 0rpx 0rpx 100rpx" vueId="{{'5fb2c237-4-'+index1}}" wx:if="{{item.g4-1!=index1}}"></u-line>
                        </view>
                    </view>
                    <view class="data-v-dd7cd12e" wx:else>
                        <view class="noCourseData data-v-dd7cd12e">
                            <image class="icon data-v-dd7cd12e" src="{{$root.m2}}"></image>
                            <text class="explain data-v-dd7cd12e">{{'~ 没有'+title+' ~'}}</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <view class="nodata data-v-dd7cd12e" wx:if="{{!notdata&&ismore}}">
            <u-divider bgColor="#f5f5f5" bind:__l="__l" borderColor="#dadada" class="data-v-dd7cd12e" color="#bfbfbf" halfWidth="74" vueId="5fb2c237-5" vueSlots="{{['default']}}">没有更多了哦</u-divider>
        </view>
        <ff-bottom-logo bind:__l="__l" class="data-v-dd7cd12e" vueId="5fb2c237-6"></ff-bottom-logo>
    </view>
</view>
