<view class="membership-container data-v-185fb87b">
    <view class="content data-v-185fb87b">
        <view class="membership-editor data-v-185fb87b">
            <view class="container data-v-185fb87b" wx:if="{{flag}}">
                <form class="data-v-185fb87b">
                    <view class="form-group form-column data-v-185fb87b">
                        <view bindtap="__e" class="toolbar data-v-185fb87b" data-event-opts="{{[ [ 'tap',[ [ 'format',['$event'] ] ] ] ]}}">
                            <view class="{{['iconfont','icon-format-header-2','_i','data-v-185fb87b',formats.header===2?'ql-active':'']}}" data-name="header" data-value="{{2}}"></view>
                            <view class="{{['iconfont','icon-format-header-3','_i','data-v-185fb87b',formats.header===3?'ql-active':'']}}" data-name="header" data-value="{{3}}"></view>
                            <view class="{{['iconfont','icon-zitijiacu','_i','data-v-185fb87b',formats.bold?'ql-active':'']}}" data-name="bold"></view>
                            <view class="{{['iconfont','icon-juzhongduiqi','_i','data-v-185fb87b',formats.align==='center'?'ql-active':'']}}" data-name="align" data-value="center"></view>
                            <view class="{{['iconfont','icon-youxupailie','_i','data-v-185fb87b',formats.list==='ordered'?'ql-active':'']}}" data-name="list" data-value="ordered"></view>
                            <view class="{{['iconfont','icon-wuxupailie','_i','data-v-185fb87b',formats.list==='bullet'?'ql-active':'']}}" data-name="list" data-value="bullet"></view>
                        </view>
                        <editor bindblur="__e" bindinput="__e" class="ql-container data-v-185fb87b" data-event-opts="{{[ [ 'input',[ [ 'onInput',['$event'] ] ] ],[ 'blur',[ [ 'onBlur',['$event'] ] ] ] ]}}" id="editor" placeholder="{{placeholder}}"></editor>
                    </view>
                </form>
            </view>
            <view bindtap="__e" class="text data-v-185fb87b" data-event-opts="{{[ [ 'tap',[ [ 'headFlag',['$event'] ] ] ] ]}}" wx:else>
                <rich-text class="rich-text data-v-185fb87b" nodes="{{blogContent}}"></rich-text>
            </view>
        </view>
        <view class="membership-button data-v-185fb87b">
            <view bindtap="__e" class="clear data-v-185fb87b" data-event-opts="{{[ [ 'tap',[ [ 'headleCreal',['$event'] ] ] ] ]}}">
                <view class="clears data-v-185fb87b" wx:if="{{flag}}">清除</view>
            </view>
            <text class="num data-v-185fb87b">{{'已写'+num+'字/最多5000字'}}</text>
        </view>
        <view class="data-v-185fb87b">
            <view bindtap="__e" class="create-Employee data-v-185fb87b" data-event-opts="{{[ [ 'tap',[ [ 'submitBlog',['$event'] ] ] ] ]}}">
                <view class="data-v-185fb87b">保存</view>
            </view>
            <view bindtap="__e" class="bg data-v-185fb87b" data-event-opts="{{[ [ 'tap',[ [ 'headDelete',['$event'] ] ] ] ]}}" wx:if="{{status=='edit'}}">
                <view class="data-v-185fb87b">删除</view>
            </view>
        </view>
    </view>
    <ff-bottom-logo bind:__l="__l" class="data-v-185fb87b" vueId="5e85bcce-1"></ff-bottom-logo>
    <confirm-modal bind:__l="__l" bind:confirm="__e" class="data-v-185fb87b vue-ref" data-event-opts="{{[ [ '^confirm',[ ['confirm'] ] ] ]}}" data-ref="confirmModal" title="确定要删除该协议吗?" vueId="5e85bcce-2" vueSlots="{{['content']}}">
        <view class="data-v-185fb87b" slot="content">
            <text class="data-v-185fb87b">点击确定后，将立即删除</text>
        </view>
    </confirm-modal>
</view>
