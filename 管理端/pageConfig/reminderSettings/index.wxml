                <view class="teacher-info data-v-1e300f2e">
                    <text class="teacher-name u-line-1 data-v-1e300f2e">{{teacher.m1}}</text>
                    <u-icon bind:__l="__l" class="staff-sex data-v-1e300f2e" color="#FF69B4" name="woman" size="28" vueId="{{'b395fee4-10-'+index+','+'b395fee4-7'}}" wx:if="{{teacher.$orig.staffSex==2}}"></u-icon>
