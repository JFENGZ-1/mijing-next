                <u-icon bind:__l="__l" class="tips_icon data-v-1e300f2e" name="bell" size="26" vueId="{{'b395fee4-8'+','+'b395fee4-7'}}"></u-icon>
                <text class="data-v-1e300f2e">选择可以<text class="highlight-text data-v-1e300f2e">接收全部消息提醒的老师</text>（通常是店内的管理人员）</text>
            </view>
        </view>
        <view class="com-button-f1 data-v-1e300f2e" slot="confrimBtn">
            <u-button bind:__l="__l" bind:click="__e" class="data-v-1e300f2e" data-event-opts="{{[ [ '^click',[ ['confirmSelection'] ] ] ]}}" type="primary" vueId="{{'b395fee4-9'+','+'b395fee4-7'}}" vueSlots="{{['default']}}">确　定</u-button>
