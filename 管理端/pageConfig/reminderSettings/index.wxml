<view class="data-v-1e300f2e">
    <navigation bind:__l="__l" class="data-v-1e300f2e" text="提醒设置" vueId="b395fee4-1"></navigation>
    <view class="placeholder-view data-v-1e300f2e" style="{{'top:'+StatusBar+CustomBar+'px'+';'}}"></view>
    <view class="main data-v-1e300f2e" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'}}">
        <view class="content data-v-1e300f2e">
            <view class="setting_wrap data-v-1e300f2e">
                <view class="top data-v-1e300f2e">
                    <u-icon bind:__l="__l" class="icon data-v-1e300f2e" color="#C96B30" name="bell" vueId="b395fee4-2"></u-icon>
                    <view class="top-info data-v-1e300f2e">
                        <view class="data-v-1e300f2e">关注“觅境约课管理系统”公众号，以下情况将通过公众号发送通知</view>
                    </view>
                </view>
                <view class="setting_group first data-v-1e300f2e">
                    <view class="setting_title data-v-1e300f2e">
                        <view class="title_color data-v-1e300f2e"></view>
                        <text class="title_text data-v-1e300f2e">店内管理人员</text>
                    </view>
                    <view class="manager_avatars data-v-1e300f2e">
                        <view class="data-v-1e300f2e" wx:for="{{selectedManagers}}" wx:for-item="manager" wx:key="index">
                            <image bindtap="__e" class="img data-v-1e300f2e" data-event-opts="{{[ [ 'tap',[ [ 'openManagerPopup',['$event'] ] ] ] ]}}" mode="aspectFill" src="{{manager.staffFace}}"></image>
                        </view>
                        <view bindtap="__e" class="avatar data-v-1e300f2e" data-event-opts="{{[ [ 'tap',[ [ 'openManagerPopup',['$event'] ] ] ] ]}}">
                            <image class="placeholder data-v-1e300f2e" mode="aspectFill" src="{{$root.m0}}"></image>
                        </view>
                    </view>
                    <view class="item_wrap data-v-1e300f2e" wx:for="{{administrators}}" wx:key="index">
                        <view class="item data-v-1e300f2e">
                            <view class="wrap data-v-1e300f2e">
                                <view class="item_laber data-v-1e300f2e">{{''+item.text+''}}</view>
                                <view class="item_title data-v-1e300f2e">{{''+item.desc+''}}</view>
                            </view>
                            <u-switch activeColor="success" activeValue="{{1}}" bind:__l="__l" bind:change="__e" bind:input="__e" class="switch data-v-1e300f2e" data-event-opts="{{[ [ '^change',[ [ 'headleStatus',['$0','$1'],[ [ ['administrators','',index,'value'] ],[ ['administrators','',index,'id'] ] ] ] ] ],[ '^input',[ [ '__set_model',[ '$0','value','$event',[] ],[ [ ['administrators','',index] ] ] ] ] ] ]}}" inactiveValue="{{0}}" size="{{60}}" slot="right" value="{{item.value}}" vueId="{{'b395fee4-3-'+index}}"></u-switch>
