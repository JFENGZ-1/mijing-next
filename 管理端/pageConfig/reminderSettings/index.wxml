                        <u-icon bind:__l="__l" class="data-v-1e300f2e" color="#1E90FF" name="man" size="28" vueId="{{'b395fee4-11-'+index+','+'b395fee4-7'}}" wx:if="{{teacher.$orig.staffSex==1}}"></u-icon>
