                        <text class="title_text data-v-1e300f2e">团课老师消息</text>
                    </view>
                    <view class="item_wrap data-v-1e300f2e" wx:for="{{league}}" wx:key="index">
                        <view class="item data-v-1e300f2e">
                            <view class="wrap data-v-1e300f2e">
                                <view class="item_laber data-v-1e300f2e">{{''+item.text}}</view>
                                <view class="item_title data-v-1e300f2e">{{''+item.desc+''}}</view>
                            </view>
                            <u-switch activeColor="success" bind:__l="__l" bind:change="__e" bind:input="__e" class="switch data-v-1e300f2e" data-event-opts="{{[ [ '^change',[ [ 'headleStatus',['$0','$1'],[ [ ['league','',index,'value'] ],[ ['league','',index,'id'] ] ] ] ] ],[ '^input',[ [ '__set_model',[ '$0','value','$event',[] ],[ [ ['league','',index] ] ] ] ] ] ]}}" size="{{60}}" slot="right" value="{{item.value}}" vueId="{{'b395fee4-4-'+index}}"></u-switch>
                        </view>
                    </view>
                </view>
                <view class="setting_group first data-v-1e300f2e">
                    <view class="setting_title data-v-1e300f2e">
                        <view class="title_color data-v-1e300f2e"></view>
                        <text class="title_text data-v-1e300f2e">私教老师消息</text>
                    </view>
                    <view class="item_wrap data-v-1e300f2e" wx:for="{{privates}}" wx:key="index">
                        <view class="item data-v-1e300f2e">
                            <view class="wrap data-v-1e300f2e">
                                <view class="item_laber data-v-1e300f2e">{{''+item.text}}</view>
                                <view class="item_title data-v-1e300f2e">{{''+item.desc+''}}</view>
                            </view>
                            <u-switch activeColor="success" bind:__l="__l" bind:change="__e" bind:input="__e" class="switch data-v-1e300f2e" data-event-opts="{{[ [ '^change',[ [ 'headleStatus',['$0','$1'],[ [ ['privates','',index,'value'] ],[ ['privates','',index,'id'] ] ] ] ] ],[ '^input',[ [ '__set_model',[ '$0','value','$event',[] ],[ [ ['privates','',index] ] ] ] ] ] ]}}" size="{{60}}" slot="right" value="{{item.value}}" vueId="{{'b395fee4-5-'+index}}"></u-switch>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <ff-bottom-logo bind:__l="__l" class="data-v-1e300f2e" vueId="b395fee4-6"></ff-bottom-logo>
    </view>
    <ff-popup bind:__l="__l" bind:input="__e" class="data-v-1e300f2e" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '','showManagerPopup','$event',[] ] ] ] ] ]}}" showConfrim="{{true}}" tipIcon="bell" title="选择老师" type="{{2}}" value="{{showManagerPopup}}" vueId="b395fee4-7" vueSlots="{{['default','tips','confrimBtn']}}">
