<view class="data-v-0228351e">
    <navigation background="{{background}}" bind:__l="__l" class="data-v-0228351e" text="{{headtitle}}" vueId="49253fca-1"></navigation>
    <view class="data-v-0228351e" style="{{'top:'+StatusBar+CustomBar+'px'+';'}}"></view>
    <view class="data-v-0228351e" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'}}">
        <view class="main data-v-0228351e" style="{{'height:100%;min-height:1230rpx; '}}">
            <view class="course-option data-v-0228351e">
                <view class="data-v-0228351e">
                    <view class="hint_wrap data-v-0228351e">
                        <hint bind:__l="__l" class="data-v-0228351e" vueId="49253fca-2" vueSlots="{{['default']}}">以下设置仅作用于下载的课程表图片</hint>
                    </view>
                    <view class="content data-v-0228351e">
                        <view class="data-v-0228351e">
                            <view class="item_radio data-v-0228351e">
                                <u-radio-group bind:__l="__l" bind:input="__e" class="data-v-0228351e" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '$0','showBackground','$event',[] ],['data'] ] ] ] ]}}" value="{{data.showBackground}}" vueId="49253fca-3" vueSlots="{{['default']}}">
                                    <u-radio bind:__l="__l" class="{{['data-v-0228351e',data.showBackground=='1'?'active':'']}}" name="1" vueId="{{'49253fca-4'+','+'49253fca-3'}}" vueSlots="{{['default']}}">
