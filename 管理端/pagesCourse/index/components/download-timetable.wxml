<view class="data-v-685818fa">
    <ff-popup bind:__l="__l" bind:close="__e" bind:input="__e" class="data-v-685818fa" data-event-opts="{{[ [ '^close',[ ['closeweek'] ] ],[ '^input',[ [ '__set_model',[ '','show','$event',[] ] ] ] ] ]}}" showConfrim="{{showConfrim}}" title="下载课表" type="{{1}}" value="{{show}}" vueId="a759e988-1" vueSlots="{{['default','confrimBtn']}}">
        <view class="com-button-f1 data-v-685818fa" slot="confrimBtn" wx:if="{{!loading}}">
            <u-button bind:__l="__l" bind:click="__e" class="data-v-685818fa" data-event-opts="{{[ [ '^click',[ ['submit'] ] ] ]}}" type="primary" vueId="{{'a759e988-2'+','+'a759e988-1'}}" vueSlots="{{['default']}}">确 定</u-button>
        </view>
        <view class="main-box data-v-685818fa" wx:if="{{!loading}}">
            <view class="btn-warp data-v-685818fa">
