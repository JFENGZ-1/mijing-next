    <u-calendar bind:__l="__l" bind:change="__e" bind:input="__e" class="data-v-685818fa vue-ref" data-event-opts="{{[ [ '^change',[ ['change'] ] ],[ '^input',[ [ '__set_model',[ '','calendarShow','$event',[] ] ] ] ] ]}}" data-ref="calendar" maxDate="2100-01-01" mode="{{type==3?'date':'range'}}" safeAreaInsetBottom="{{true}}" showConfirm="{{false}}" value="{{calendarShow}}" vueId="a759e988-5"></u-calendar>
</view>
