    <view class="placeholder-view data-v-685f3406" style="{{'top:'+StatusBar+CustomBar+'px'+';'}}"></view>
    <view class="subject-edit-container data-v-685f3406" style="{{'margin-top:'+StatusBar+CustomBar+'px'+';'}}">
