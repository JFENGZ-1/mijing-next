                    <text class="data-v-685f3406" style="font-size:14px;color:#DADADA;" wx:if="{{!groupData.courseAddr}}">可不填写</text>
                    <text class="data-v-685f3406" wx:if="{{groupData.courseAddr}}">{{groupData.courseAddr}}</text>
                </u-cell-item>
