                <u-form-item bind:__l="__l" class="data-v-685f3406" label="课程时长" labelWidth="170" prop="courseDuringTime" required="{{true}}" vueId="{{'12e6a0da-5'+','+'12e6a0da-3'}}" vueSlots="{{['default']}}">
