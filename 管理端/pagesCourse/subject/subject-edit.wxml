            <suject-classroom bind:__l="__l" bind:editclassroom="__e" bind:headleClose="__e" class="data-v-685f3406 vue-ref" courseAddr="{{groupData.courseAddr}}" data-event-opts="{{[ [ '^editclassroom',[ ['editclassroom'] ] ],[ '^headleClose',[ ['headleClose'] ] ] ]}}" data-ref="classroomChild" vueId="12e6a0da-16"></suject-classroom>
