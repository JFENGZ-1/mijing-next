                    <u-input bind:__l="__l" bind:input="__e" class="input data-v-685f3406" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '$0','courseDuringTime','$event',[] ],['groupData'] ] ] ] ]}}" placeholder="如60" placeholderStyle="font-size: 14px;color: #DADADA;" style="display:none;" type="number" value="{{groupData.courseDuringTime}}" vueId="{{'12e6a0da-7'+','+'12e6a0da-5'}}"></u-input>
                </u-form-item>
