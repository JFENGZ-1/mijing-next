<view class="trainer-popup-container data-v-3f0f5dfc">
    <ff-popup bind:__l="__l" bind:headleClose="__e" bind:input="__e" class="data-v-3f0f5dfc" data-event-opts="{{[ [ '^headleClose',[ ['headleClose'] ] ],[ '^input',[ [ '__set_model',[ '','trainerPopupShow','$event',[] ] ] ] ] ]}}" height="{{1100}}" showConfrim="{{false}}" title="选择老师" value="{{trainerPopupShow}}" vueId="8602ad8c-1" vueSlots="{{['default']}}">
        <view class="trainer-popup data-v-3f0f5dfc">
            <view class="head data-v-3f0f5dfc" wx:if="{{coursetype==0}}">
                <u-icon bind:__l="__l" class="data-v-3f0f5dfc" color="#C96B30" name="bell" size="20rpx" vueId="{{'8602ad8c-2'+','+'8602ad8c-1'}}"></u-icon>
                <text class="data-v-3f0f5dfc">在”排课/课程“内排课时，也可以更换教练</text>
            </view>
            <view class="headbut data-v-3f0f5dfc">
                <view class="button-list data-v-3f0f5dfc">
                    <view bindtap="__e" class="trainer-content data-v-3f0f5dfc" data-event-opts="{{[ [ 'tap',[ [ 'changetrainer',['$0'],[ [ ['trainerList','',index] ] ] ] ] ] ]}}" wx:for="{{$root.l0}}" wx:key="index">
                        <image class="head-img data-v-3f0f5dfc" src="{{item.$orig.staffFace}}"></image>
                        <view class="trainer-sex data-v-3f0f5dfc">
                            <view class="trainer-text u-line-1 data-v-3f0f5dfc">{{item.$orig.staffName}}</view>
                            <view class="data-v-3f0f5dfc">
                                <image class="seximg1 data-v-3f0f5dfc" src="{{item.m0}}" wx:if="{{item.$orig.staffSex==2}}"></image>
                                <image class="seximg data-v-3f0f5dfc" src="{{item.m1}}" wx:if="{{item.$orig.staffSex==1}}"></image>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </ff-popup>
    <u-modal bind:__l="__l" bind:input="__e" class="data-v-3f0f5dfc" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '','delShow','$event',[] ] ] ] ] ]}}" showConfirmButton="{{false}}" showTitle="{{false}}" value="{{delShow}}" vueId="8602ad8c-3" vueSlots="{{['default']}}" width="{{700}}">
        <view class="modal data-v-3f0f5dfc">
            <text class="modal-title data-v-3f0f5dfc">提示：没有可选择的教练</text>
            <view class="modal-content data-v-3f0f5dfc">
                <u-icon bind:__l="__l" class="data-v-3f0f5dfc" color="#2979ff" name="error-circle-fill" size="70" vueId="{{'8602ad8c-4'+','+'8602ad8c-3'}}"></u-icon>
                <text class="data-v-3f0f5dfc">请先在【教练/员工】中添加新的教练</text>
            </view>
            <view class="btn data-v-3f0f5dfc">
                <button bindtap="__e" class="modal-btn data-v-3f0f5dfc" data-event-opts="{{[ [ 'tap',[ [ 'cancelbtn',['$event'] ] ] ] ]}}">知道了</button>
            </view>
        </view>
    </u-modal>
</view>
