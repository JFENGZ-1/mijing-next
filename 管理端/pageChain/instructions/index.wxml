                    <view class="logo-wrap data-v-ce8c5d7c">
                        <image class="pic data-v-ce8c5d7c" src="{{$root.m4}}"></image>
                    </view>
                    <view class="text-wrap data-v-ce8c5d7c">售卡统计</view>
                </view>
                <view class="right-text data-v-ce8c5d7c">
                    <text class="title data-v-ce8c5d7c">5、查看【多店通用卡】销售数据</text>
                    <text class="data-v-ce8c5d7c" userSelect="{{true}}"> 仅统计多店通用卡的售出和持有情况（不统计各分店的卡） </text>
                </view>
            </view>
