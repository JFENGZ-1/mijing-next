APP_NAME="Mijing Next API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mijing_next
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Queue (production: database or redis + `php artisan queue:work`)
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

# SMS gateway (production: replace log driver with vendor implementation)
SMS_DRIVER=log

# Payment gateway: demo auto-pays; wechat creates pending orders + webhook fulfillment
PAYMENT_DRIVER=demo
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_WEBHOOK_SECRET=

# Super admin Web and managed media. Payment secrets entered in Admin Web are encrypted in the database.
SUPER_ADMIN_SESSION_HOURS=8
ADMIN_MEDIA_DISK=public
ADMIN_MEDIA_MAX_KILOBYTES=102400

WECHAT_MEMBER_APPID=
WECHAT_MEMBER_SECRET=
WECHAT_STAFF_APPID=
WECHAT_STAFF_SECRET=
# Online demo only: automatically grant each staff Mini Program user an isolated demo staff identity.
WECHAT_STAFF_DEMO_AUTO_PROVISION=false
WECHAT_STAFF_DEMO_TENANT_CODE=mijing
WECHAT_STAFF_DEMO_SITE_CODE=main
# Optional local DevTools binding for ADMIN001 after `system:bootstrap`
WECHAT_DEV_STAFF_OPENID=

# Token for /dev/* tools when APP_ENV is not local (query ?token= or header X-Dev-Tools-Token)
DEV_TOOLS_TOKEN=
