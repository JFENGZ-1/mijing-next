{
  "name": "@mijing/admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "contract:sync": "node scripts/sync-contract.mjs",
    "contract:accept": "node scripts/sync-contract.mjs --accept",
    "contract:types": "openapi-typescript ../../docs/openapi.yaml -o src/generated/schema.d.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.5",
    "pinia": "^2.3.1",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.0"
  }
}
