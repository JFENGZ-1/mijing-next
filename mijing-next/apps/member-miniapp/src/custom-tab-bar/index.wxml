<view class="tab-bar">
  <view
    wx:for="{{items}}"
    wx:key="pagePath"
    class="tab-bar__item"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <block wx:if="{{selected == index}}">
      <image class="tab-bar__icon" src="{{item.selectedIconPath}}" />
      <view class="tab-bar__text tab-bar__text--selected">{{item.text}}</view>
    </block>
    <block wx:else>
      <image class="tab-bar__icon" src="{{item.iconPath}}" />
      <view class="tab-bar__text">{{item.text}}</view>
    </block>
  </view>
</view>
