<view class="data-v-6a42078d">
    <view class="info-wrap data-v-6a42078d" wx:if="{{cardInfo}}">
        <view class="item data-v-6a42078d">
            <view class="title data-v-6a42078d">卡内额度</view>
            <view class="info-text data-v-6a42078d">{{cardInfo.amountDepositCard.cardAmount+'元'}}<block wx:if="{{cardInfo.amountDepositCard.presentAmount}}">{{''+'+赠'+cardInfo.amountDepositCard.presentAmount+'元'+''}}</block>
            </view>
        </view>
        <view class="item data-v-6a42078d">
            <view class="title data-v-6a42078d">享受折扣</view>
            <view class="info-text data-v-6a42078d">
                <block wx:if="{{cardInfo.amountDepositCard.discount}}">{{''+cardInfo.amountDepositCard.discount+'折'}}</block>
                <block wx:else>无折扣</block>
            </view>
        </view>
        <view class="item data-v-6a42078d">
            <view class="title data-v-6a42078d">有效期</view>
            <view class="info-text data-v-6a42078d">
                <block wx:if="{{cardInfo.cardValidYear}}">{{cardInfo.cardValidYear+'年'}}</block>
                <block wx:if="{{cardInfo.cardValidMonth}}">{{cardInfo.cardValidMonth+'个月'}}</block>
                <block wx:if="{{cardInfo.cardValidDays}}">{{cardInfo.cardValidDays+'天'}}</block>
            </view>
        </view>
    </view>
</view>
