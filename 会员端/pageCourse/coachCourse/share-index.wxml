<view class="data-v-6017c918">
    <view class="data-v-6017c918" wx:if="{{info}}">
        <view class="header data-v-6017c918" style="{{'height:'+totalH+'px'+';'}}">
            <view class="fixed_bg data-v-6017c918" style="{{'background:'+'url('+info.data.staffFace+')'+';'+'background-size:'+'750rpx 750rpx'+';'+'height:'+totalH+'px'+';'}}"></view>
            <view class="fixed_content data-v-6017c918" style="{{'height:'+totalH+'px'+';'}}">
                <view class="statusBar data-v-6017c918" style="{{'height:'+statusBar+'px'+';'}}"></view>
                <view class="customBar data-v-6017c918" style="{{'height:'+customBar+'px'+';'}}">
                    <view bindtap="__e" class="back-wrap data-v-6017c918" data-event-opts="{{[ [ 'tap',[ [ 'back',['$event'] ] ] ] ]}}">
                        <u-icon bind:__l="__l" class="data-v-6017c918" color="#181818" name="arrow-left" size="35" vueId="0c5613b3-1"></u-icon>
                    </view>
                </view>
                <view class="content data-v-6017c918">
                    <view class="coach_ifon_wrap data-v-6017c918" style="{{'margin-top:'+'-'+customBar/2+3+'px'+';'}}">
                        <view class="photo_portrait data-v-6017c918">
                            <image class="photo_img data-v-6017c918" src="{{info.data.staffFace}}"></image>
                            <view class="tag_wrap data-v-6017c918" wx:if="{{info.data.tagText&&info.data.tagText!='不指定'}}">
                                <image class="tag-icon-left data-v-6017c918" src="{{$root.m0}}"></image>
                                <view class="text data-v-6017c918">{{info.data.tagText}}</view>
                                <image class="tag-icon-right data-v-6017c918" src="{{$root.m1}}"></image>
                            </view>
                        </view>
                        <view class="name data-v-6017c918">
                            <text class="data-v-6017c918">{{info.data.staffName}}</text>
                            <image class="man data-v-6017c918" src="{{$root.m2}}" wx:if="{{info.data.staffSex==1}}"></image>
                            <image class="women data-v-6017c918" src="{{$root.m3}}" wx:if="{{info.data.staffSex==2}}"></image>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <view class="main data-v-6017c918">
            <view class="info data-v-6017c918">
                <view class="top data-v-6017c918">
                    <view class="first data-v-6017c918">
                        <view class="title data-v-6017c918">经历：</view>
                        <view class="content data-v-6017c918">{{info.data.experience}}</view>
                    </view>
                    <view class="last data-v-6017c918">
                        <view class="title data-v-6017c918">擅长：</view>
                        <view class="content data-v-6017c918">{{info.data.goodat}}</view>
                    </view>
                </view>
                <view class="bottom data-v-6017c918">
                    <view class="item data-v-6017c918">
                        <view class="info-title data-v-6017c918">
                            <image class="data-v-6017c918" src="{{$root.m4}}"></image>
                            <text class="data-v-6017c918">可预约时间</text>
                        </view>
                        <view class="info-content data-v-6017c918">
                            <view class="timer-item data-v-6017c918" wx:for="{{info.data.timeList}}" wx:key="index">{{''+item.weekValue+' '+item.timeValue+''}}</view>
                        </view>
                    </view>
                    <view class="item data-v-6017c918" style="margin-top:26rpx;">
                        <view class="info-title data-v-6017c918">
                            <image class="data-v-6017c918" src="{{$root.m5}}"></image>
                            <text class="data-v-6017c918">电话</text>
                        </view>
                        <view class="info-content data-v-6017c918">
                            <view class="phone_num data-v-6017c918">{{info.data.staffTel+''}}</view>
                        </view>
                    </view>
                </view>
            </view>
            <view class="appointment_list data-v-6017c918">
                <view class="title_text data-v-6017c918">我的预约</view>
                <view class="list-wrap data-v-6017c918">
                    <view class="list data-v-6017c918">
                        <view class="item data-v-6017c918" wx:for="{{$root.l0}}" wx:key="index">
                            <view class="flex data-v-6017c918">
                                <view class="photo_img data-v-6017c918">
                                    <image class="data-v-6017c918" src="{{item.$orig.userFaceurl}}"></image>
                                </view>
                                <view class="info_box data-v-6017c918">
                                    <view class="info_box_wrap data-v-6017c918">
                                        <view class="left_box data-v-6017c918">
                                            <view class="course_name data-v-6017c918">
                                                <text class="data-v-6017c918">{{item.$orig.userNickname}}</text>
                                            </view>
                                            <view class="time_info flex data-v-6017c918">
                                                <text class="data-v-6017c918" decode="{{true}}">{{''+item.m6+''}}</text>
                                            </view>
                                            <view class="course_project data-v-6017c918" wx:if="{{item.$orig.dataidType==1&&item.$orig.courseName}}">
                                                <view class="project_item data-v-6017c918">{{item.$orig.courseName}}</view>
                                            </view>
                                            <view class="remake data-v-6017c918" wx:if="{{item.$orig.remark}}">{{'备注：'+item.$orig.remark+''}}</view>
                                        </view>
                                        <view class="right_box data-v-6017c918">
                                            <view class="{{['consumption','data-v-6017c918',item.$orig.cardChangeAmount==0?'visibility':'']}}">
                                                <block wx:if="{{item.$orig.plusMinus}}">{{item.$orig.plusMinus}}</block>{{''+item.$orig.cardChangeAmount+item.$orig.unitName+''}}</view>
                                            <view class="balance flex data-v-6017c918">{{'余'+''+item.$orig.leftAmount+item.$orig.unitName}}</view>
                                            <view class="status flex data-v-6017c918">
                                                <text class="data-v-6017c918" style="{{'color:'+item.m7+';'}}">{{''+item.$orig.unionStatusName}}</text>
                                                <text class="data-v-6017c918" style="margin-left:3rpx;" wx:if="{{item.$orig.manCount>1}}">{{'('+item.$orig.manCount+'人)'}}</text>
                                            </view>
                                            <view bindtap="__e" class="open_handle_mumber data-v-6017c918" data-event-opts="{{[ [ 'tap',[ [ 'toggleDrop',['$0'],[ [ ['info.list','',index] ] ] ] ] ] ]}}" wx:if="{{item.$orig.waitUserTag==0&&item.$orig.appointStatus==0||item.$orig.waitUserTag==1&&item.$orig.waitStatus==1&&item.$orig.waitStatus==3}}">
                                                <u-icon bind:__l="__l" class="data-v-6017c918" color="#696B99" name="more-dot-fill" size="32" vueId="{{'0c5613b3-2-'+index}}"></u-icon>
                                                <view class="drop_down data-v-6017c918" wx:if="{{item.$orig.dropShow}}">
                                                    <view class="image_wrap data-v-6017c918">
                                                        <image class="data-v-6017c918" src="{{item.m8}}"></image>
                                                    </view>
                                                    <view class="drop_down_list data-v-6017c918">
                                                        <view bindtap="__e" class="handle_item data-v-6017c918" data-event-opts="{{[ [ 'tap',[ [ 'cancelAppointment',['$0'],[ [ ['info.list','',index] ] ] ] ] ] ]}}" wx:if="{{item.$orig.waitUserTag==0&&item.$orig.appointStatus==0}}">
                                                            <image class="data-v-6017c918" src="{{item.m9}}" style="width:34rpx;height:33rpx;"></image>
                                                            <text class="data-v-6017c918">取消预约</text>
                                                        </view>
                                                    </view>
                                                </view>
                                            </view>
                                        </view>
                                    </view>
                                    <u-line bind:__l="__l" class="data-v-6017c918" color="#F0F0F0" hairLine="{{false}}" vueId="{{'0c5613b3-3-'+index}}"></u-line>
                                </view>
                            </view>
                        </view>
                    </view>
                    <view class="noCourseData data-v-6017c918" wx:if="{{$root.g0==0}}">
                        <image class="data-v-6017c918" src="{{$root.m10}}"></image>
                        <text class="data-v-6017c918">~ 我的约课 ~</text>
                    </view>
                </view>
            </view>
            <view class="attention_matter data-v-6017c918" wx:if="{{kindReminder.text}}">
                <view class="title_text data-v-6017c918" wx:if="{{kindReminder.title}}">{{kindReminder.title}}</view>
                <u-parse bind:__l="__l" class="text_item data-v-6017c918" html="{{kindReminder.text}}" style="padding-left:0rpx;" vueId="0c5613b3-4"></u-parse>
            </view>
            <view class="attention_matter data-v-6017c918">
                <view class="title_text data-v-6017c918">注意事项</view>
                <view class="text_item data-v-6017c918" wx:for="{{info.msglist}}" wx:key="index">{{item}}</view>
            </view>
            <view class="browse_view data-v-6017c918">
                <view bindtap="__e" class="item first data-v-6017c918" data-event-opts="{{[ [ 'tap',[ [ 'shareCourse',['$event'] ] ] ] ]}}">
                    <button class="data-v-6017c918" openType="share">
                        <view class="icon_img data-v-6017c918">
                            <image class="data-v-6017c918" mode="widthFix" src="{{$root.m11}}" style="width:66rpx;"></image>
                        </view>
                        <view class="title data-v-6017c918">转发到群</view>
                        <view class="hint data-v-6017c918">会员打开页面后可直接约课</view>
                    </button>
                </view>
                <view bindtap="__e" class="item data-v-6017c918" data-event-opts="{{[ [ 'tap',[ [ 'quit',['$event'] ] ] ] ]}}">
                    <view class="icon_img data-v-6017c918">
                        <image class="data-v-6017c918" mode="widthFix" src="{{$root.m12}}" style="width:53rpx;"></image>
                    </view>
                    <view class="title data-v-6017c918">返回</view>
                    <view class="hint data-v-6017c918"></view>
                </view>
            </view>
        </view>
        <bottom-logo bind:__l="__l" class="data-v-6017c918" vueId="0c5613b3-5"></bottom-logo>
        <view class="data-v-6017c918" style="padding-bottom:140rpx;"></view>
        <confrim-moadl bind:__l="__l" bind:confirm="__e" class="data-v-6017c918 vue-ref" data-event-opts="{{[ [ '^confirm',[ ['ok'] ] ] ]}}" data-ref="confrimMoadl" title="{{confrimTitle}}" vueId="0c5613b3-6" vueSlots="{{['content']}}">
            <view class="data-v-6017c918" slot="content">
                <view class="data-v-6017c918">将退还已扣相应费用</view>
            </view>
        </confrim-moadl>
        <selected-course-timer bind:__l="__l" bind:ok="__e" class="data-v-6017c918 vue-ref" data-event-opts="{{[ [ '^ok',[ ['update'] ] ] ]}}" data-ref="selectedCourseTimer" vueId="0c5613b3-7"></selected-course-timer>
    </view>
</view>
