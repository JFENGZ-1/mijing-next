<view bindtap="__e" class="flex data-v-1315120a" data-event-opts="{{[ [ 'tap',[ [ 'appointDetails',['$0'],['item'] ] ] ] ]}}">
    <view class="photo_img data-v-1315120a">
        <image class="icon data-v-1315120a" src="{{item.staffFace}}"></image>
    </view>
    <view class="info_box data-v-1315120a">
        <view class="info_box_wrap data-v-1315120a">
            <view class="row_item first_row_item data-v-1315120a">
                <view class="course_name data-v-1315120a">
                    <text class="name data-v-1315120a">{{$root.m0}}</text>
                    <view class="tag_wrap data-v-1315120a" wx:if="{{item.tagData&&item.tagData!='不指定'}}">
                        <image class="arrow data-v-1315120a" src="{{$root.m1}}"></image>
                        <view class="tag_text data-v-1315120a">{{item.tagData}}</view>
                    </view>
                </view>
                <view class="{{['consumption','data-v-1315120a',item.cardChangeAmount==0?'visibility':'']}}">
                    <text class="plus-minus data-v-1315120a" wx:if="{{item.plusMinus}}">{{item.plusMinus}}</text>{{''+''+item.cardChangeAmount+item.unitName+(item.groupName||'')+''}}</view>
            </view>
            <view class="row_item data-v-1315120a">
                <view class="multiterm_info data-v-1315120a" wx:if="{{item.dataidType==0}}">
                    <view class="coach_name data-v-1315120a" wx:if="{{item.staffName}}">{{$root.m2}}</view>
                    <view class="classroom_wrap flex data-v-1315120a" wx:if="{{item.courseAddr}}">
                        <u-line bind:__l="__l" class="data-v-1315120a" color="#989898" direction="col" hairLine="{{false}}" length="22" margin="0 15rpx" vueId="2eafffbc-1"></u-line>
                        <text class="data-v-1315120a">{{item.courseAddr}}</text>
                    </view>
                    <view class="difficulty_wrap flex data-v-1315120a" wx:if="{{item.degreeNum>0}}">
                        <u-line bind:__l="__l" class="data-v-1315120a" color="#989898" direction="col" hairLine="{{false}}" length="22" margin="0 15rpx" vueId="2eafffbc-2"></u-line>
                        <text class="data-v-1315120a">难度</text>
                        <view class="star-level data-v-1315120a">
                            <image class="star data-v-1315120a" src="{{i.m3}}" wx:for="{{$root.l0}}" wx:for-index="__i0__" wx:for-item="i" wx:key="$orig"></image>
                        </view>
                    </view>
                </view>
                <view class="time_info flex data-v-1315120a" wx:else>
                    <text class="time data-v-1315120a">{{$root.m4.month+'-'+$root.m5.day+' '+item.weekName}}</text>
                    <view class="time_quantum data-v-1315120a">{{$root.m6.hours+':'+$root.m7.minutesurs+'~'+$root.m8.hours+':'+$root.m9.minutesurs}}</view>
                </view>
                <view class="balance flex data-v-1315120a">{{'余'+''+item.leftAmount+item.unitName}}</view>
            </view>
            <view class="row_item data-v-1315120a" style="margin-top:5rpx;margin-bottom:3rpx;">
                <view class="time_info flex data-v-1315120a" wx:if="{{item.dataidType==0}}">
                    <text class="time data-v-1315120a">{{$root.m10.month+'-'+$root.m11.day+' '+item.weekName}}</text>
                    <view class="time_quantum data-v-1315120a">{{$root.m12.hours+':'+$root.m13.minutesurs+'~'+$root.m14.hours+':'+$root.m15.minutesurs}}</view>
                </view>
                <view class="course_project data-v-1315120a" wx:if="{{item.dataidType==1&&item.courseName}}">
                    <view class="project_item data-v-1315120a">{{$root.m16}}</view>
                </view>
                <view class="status flex data-v-1315120a">
                    <view class="handle_person data-v-1315120a" wx:if="{{item.helpStaffFace&&item.helpStaffName}}">
                        <view class="photo-wrap data-v-1315120a">
                            <image class="Staff-face data-v-1315120a" src="{{item.helpStaffFace}}"></image>
                        </view>
                        <text class="Staff-name data-v-1315120a" wx:if="{{item.helpStaffName}}">{{$root.m17+'操作'}}</text>
                    </view>
                    <text class="data-v-1315120a" style="{{'color:'+$root.m18+';'}}">{{''+item.unionStatusName+''}}<text class="data-v-1315120a" style="margin-left:3rpx;" wx:if="{{item.manCount>1}}">{{'('+item.manCount+'人)'}}</text>
                    </text>
                </view>
            </view>
            <view class="row_item data-v-1315120a" style="margin-top:6rpx;align-items:flex-start;display:flex;margin-bottom:8rpx;">
                <view class="data-v-1315120a" style="flex:1;">
                    <view class="remake data-v-1315120a" style="margin-bottom:8rpx;" wx:if="{{item.remark}}">{{'留言：'+item.remark+''}}</view>
                    <view class="remake data-v-1315120a" style="padding-top:3rpx;" wx:if="{{item.otherSiteName}}">
                        <text class="other-site data-v-1315120a">门店</text>
                        <text class="other-name data-v-1315120a">{{item.otherSiteName?item.otherSiteName:''}}</text>
                    </view>
                </view>
                <view catchtap="__e" class="open_handle_mumber data-v-1315120a" data-event-opts="{{[ [ 'tap',[ [ 'toggleDrop',['$0'],['item'] ] ] ] ]}}" wx:if="{{( item.waitUserTag==0&&item.appointStatus==0||item.waitUserTag==1&&(item.waitStatus==1||item.waitStatus==3) )&&isHandleBtn}}">
                    <u-icon bind:__l="__l" class="data-v-1315120a" color="#696B99" name="more-dot-fill" size="32" vueId="2eafffbc-3"></u-icon>
                    <view class="drop_down data-v-1315120a" wx:if="{{item.dropShow}}">
                        <view class="image_wrap data-v-1315120a">
                            <image class="pic data-v-1315120a" src="{{$root.m19}}"></image>
                        </view>
                        <view class="drop_down_list data-v-1315120a">
                            <view bindtap="__e" class="handle_item data-v-1315120a" data-event-opts="{{[ [ 'tap',[ [ 'cancelAppointment',['$0'],['item'] ] ] ] ]}}" wx:if="{{item.waitUserTag==0&&item.appointStatus==0}}">
                                <image class="cancel-pic data-v-1315120a" src="{{$root.m20}}" style="width:34rpx;height:33rpx;"></image>
                                <text class="cancel-font data-v-1315120a">取消预约</text>
                            </view>
                            <view bindtap="__e" class="handle_item data-v-1315120a" data-event-opts="{{[ [ 'tap',[ [ 'cancelLineUp',['$0'],['item'] ] ] ] ]}}" wx:if="{{item.waitUserTag==1&&(item.waitStatus==1||item.waitStatus==3)}}">
                                <image class="cancel-pic data-v-1315120a" src="{{$root.m21}}" style="width:39rpx;height:39rpx;"></image>
                                <text class="cancel-font data-v-1315120a">取消排队</text>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <u-line bind:__l="__l" class="data-v-1315120a" color="#F0F0F0" vueId="2eafffbc-4"></u-line>
    </view>
</view>
