<view class="{{['data-v-2ec21530',activeClass,'card-box']}}" style="{{'background-image:'+'url('+(cardInfo.uploadURL?cardInfo.uploadURL+cardInfo.cardLogo:cardInfo.cardLogo)+')'+';'}}" wx:if="{{cardInfo}}">
    <view class="data-v-2ec21530" wx:if="{{cardInfo.isUnionCard==1}}">
        <view class="ribbonUnion data-v-2ec21530" style="background:rgba(52, 159, 145, 0.88);">
            <text class="data-v-2ec21530">计次卡</text>
        </view>
        <view class="ribbonUniversal data-v-2ec21530" style="background:#F7D29F;">
            <text class="data-v-2ec21530">多  店  通  用</text>
        </view>
    </view>
    <view class="ribbonUnion data-v-2ec21530" style="background:rgba(52, 159, 145, 0.88);" wx:else>
        <text class="data-v-2ec21530">计次卡</text>
    </view>
    <view class="card-conntent data-v-2ec21530">
        <view class="shop-info data-v-2ec21530" wx:if="{{cardInfo.isUnionCard==1}}">
            <image class="data-v-2ec21530" src="{{cardInfo.unLogo}}"></image>
            <text class="data-v-2ec21530">{{cardInfo.unName}}</text>
        </view>
        <view class="shop-info data-v-2ec21530" wx:else>
            <image class="data-v-2ec21530" src="{{siteTrademark}}"></image>
            <text class="data-v-2ec21530">{{siteName}}</text>
        </view>
        <view class="{{['card-name','data-v-2ec21530',$root.g0>6?'card-name-size-max':'']}}" wx:if="{{cardInfo.cardName}}">{{cardInfo.cardName}}</view>
    </view>
    <view class="bottom-info data-v-2ec21530">
        <view class="project-box data-v-2ec21530">
            <view class="project-item-wrap data-v-2ec21530" wx:if="{{$root.g1}}">
                <block wx:for="{{$root.l0}}" wx:key="index">
                    <view class="{{['project-item','data-v-2ec21530',item.$orig.isPresent?'presenter-course':'']}}" wx:if="{{index<4}}">
                        <view class="num data-v-2ec21530">{{item.$orig.timeCount+'次'}}</view>
                        <view class="name data-v-2ec21530">
                            <text class="data-v-2ec21530" wx:if="{{item.$orig.isPresent}}">赠</text>{{item.$orig.groupName}}</view>
                    </view>
                    <u-line bind:__l="__l" class="data-v-2ec21530" color="{{''+(item.g2?'rgba(255, 255, 255, 0.3)':'transparent')}}" direction="col" length="{{''+(activeClass=='large-size'?'56':activeClass=='medium-sized'?'35rpx':'30rpx')}}" margin="{{''+(activeClass=='large-size'?'0rpx 6rpx':activeClass=='medium-sized'?'0rpx 5rpx':'0rpx 4rpx')}}" vueId="{{'ecbff07c-1-'+index}}" wx:if="{{index<4}}"></u-line>
                </block>
                <view catchtap="__e" class="project-more data-v-2ec21530" data-event-opts="{{[ [ 'tap',[ [ 'moreClick',['$event'] ] ] ] ]}}" wx:if="{{$root.g3>4}}">
                    <view class="scale-area data-v-2ec21530"></view>
                    <image class="data-v-2ec21530" src="{{$root.m0}}"></image>
                </view>
            </view>
            <view class="item total-times-wrap data-v-2ec21530" wx:else>
                <text class="num count total-times data-v-2ec21530">{{(cardInfo.orginalAmount.totalTimes?cardInfo.amountTimeCard.totalTimes:0)+'次'}}</text>
            </view>
        </view>
        <view class="period-box data-v-2ec21530">有效期<block wx:if="{{cardInfo.cardValidForever}}">永久有效</block>
            <block wx:else>
                <block wx:if="{{cardInfo.cardValidYear}}">{{cardInfo.cardValidYear+'年'}}</block>
                <block wx:if="{{cardInfo.cardValidMonth}}">{{cardInfo.cardValidMonth+'个月'}}</block>
                <block wx:if="{{cardInfo.cardValidDays}}">{{cardInfo.cardValidDays+'天'}}</block>
            </block>
        </view>
    </view>
</view>
